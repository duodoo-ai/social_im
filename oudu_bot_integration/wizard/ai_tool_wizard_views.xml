<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- AI Tool Execute Wizard Form View -->
        <record id="view_ai_tool_execute_wizard_form" model="ir.ui.view">
            <field name="name">oudu.bot.tool.execute.wizard.form</field>
            <field name="model">oudu.bot.tool.execute.wizard</field>
            <field name="arch" type="xml">
                <form string="Execute AI Tool">
                    <sheet>
                        <group>
                            <group>
                                <label for="tool_name" string="Tool Information"/>
                                <div>
                                    <field name="tool_name" readonly="1"/>
                                    <field name="tool_type" readonly="1"/>
                                </div>
                            </group>
                            <group>
                                <label for="parameters_display" string="Parameters Schema"/>
                                <field name="parameters_display" readonly="1" nolabel="1" options="{'mode': 'json'}"/>
                            </group>
                        </group>
                        
                        <group string="Input Arguments">
                            <field name="input_arguments" nolabel="1" options="{'mode': 'json'}"/>
                        </group>
                        
                        <group string="Execution Result" invisible="result">
                            <field name="result" nolabel="1" readonly="1" options="{'mode': 'text'}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_test_demo" string="Test Demo" type="object" class="btn-secondary"/>
                        <button name="action_execute" string="Execute" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- AI Tool Execute Wizard Action -->
        <record id="action_ai_tool_execute_wizard" model="ir.actions.act_window">
            <field name="name">Execute AI Tool</field>
            <field name="res_model">oudu.bot.tool.execute.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>