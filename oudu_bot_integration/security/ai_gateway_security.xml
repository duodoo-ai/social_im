<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Security Categories -->
        <record model="ir.module.category" id="category_ai_agent">
			<field name="name">AI Agent Integration</field>
			<field name="sequence">1</field>
		</record>

        <!-- Security Groups -->
        <record id="group_ai_admin" model="res.groups">
            <field name="name">AI Administrator</field>
            <field name="category_id" ref="category_ai_agent"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ai_developer" model="res.groups">
            <field name="name">AI Developer</field>
            <field name="category_id" ref="category_ai_agent"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>

        <record id="group_ai_user" model="res.groups">
            <field name="name">AI User</field>
            <field name="category_id" ref="category_ai_agent"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>