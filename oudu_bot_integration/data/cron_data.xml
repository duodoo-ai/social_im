<odoo>
    <data noupdate="0">
        <!-- Scheduled task for daily balance checks -->
        <record id="cron_ai_provider_balance_check" model="ir.cron">
            <field name="name">[AI Gateway] Provider Balance Check</field>
            <field name="model_id" ref="model_oudu_bot_provider_balance"/>
            <field name="state">code</field>
            <field name="code">model.cron_check_balances()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
