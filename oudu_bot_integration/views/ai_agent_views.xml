<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_ai_agent_list" model="ir.ui.view">
            <field name="name">oudu.bot.agent.list</field>
            <field name="model">oudu.bot.agent</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="provider_id"/>
                    <field name="model_name"/>
                    <field name="is_active"/>
                    <field name="execution_count"/>
                    <field name="last_execution"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_ai_agent_form" model="ir.ui.view">
            <field name="name">oudu.bot.agent.form</field>
            <field name="model">oudu.bot.agent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="execute" type="object" string="Test Execute" class="btn-primary"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="provider_id"/>
                                <field name="model_name"/>
                            </group>
                            <group>
                                <field name="is_active"/>
                                <field name="execution_count" readonly="1"/>
                                <field name="last_execution" readonly="1"/>
                                <!-- 添加工作流计数字段 -->
                                <field name="workflow_count" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Configuration">
                                <group>
                                    <field name="system_prompt" widget="text" nolabel="1" placeholder="System prompt for the AI agent..."/>
                                </group>
                                <group>
                                    <group string="Model Parameters">
                                        <field name="temperature"/>
                                        <field name="max_tokens"/>
                                        <field name="top_p"/>
                                    </group>
                                    <group string="Capabilities">
                                        <field name="enable_tool_calling"/>
                                        <field name="enable_knowledge_retrieval"/>
                                        <field name="enable_reasoning"/>
                                        <field name="allow_auto_execution"/>
                                    </group>
                                </group>
                            </page>

                            <!-- 修正 Tools 页面：使用常规 many2many 部件 -->
                            <page string="Tools">
                                <field name="tools_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="tool_type"/>
                                        <field name="is_active"/>
                                    </list>
                                    <form>
                                        <group>
                                            <field name="name"/>
                                            <field name="code"/>
                                            <field name="description"/>
                                            <field name="tool_type"/>
                                            <field name="is_active"/>
                                        </group>
                                    </form>
                                </field>
                            </page>

                            <!-- 修正 Knowledge 页面：使用常规 many2many 部件 -->
                            <page string="Knowledge">
                                <field name="knowledge_base_ids" nolabel="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Workflows">
                                <group>
                                    <label for="workflow_count" string="Workflow Summary"/>
                                    <div>
                                        <field name="workflow_count" readonly="1"/>
                                        <button name="action_view_workflows"
                                                type="object"
                                                string="View All Workflows"
                                                class="btn-secondary"/>
                                    </div>
                                </group>
                                <!--简化的工作流显示 -->
                                <field name="workflow_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="is_active"/>
                                        <field name="execution_count"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Alternative Form View with simplified workflow display -->
        <record id="view_ai_agent_form_simple" model="ir.ui.view">
            <field name="name">oudu.bot.agent.form.simple</field>
            <field name="model">oudu.bot.agent</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="execute" type="object" string="Test Execute" class="btn-primary"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="provider_id"/>
                                <field name="model_name"/>
                            </group>
                            <group>
                                <field name="is_active"/>
                                <field name="execution_count" readonly="1"/>
                                <field name="last_execution" readonly="1"/>
                                <field name="workflow_count" readonly="1"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="Configuration">
                                <group>
                                    <field name="system_prompt" widget="text" nolabel="1" placeholder="System prompt for the AI agent..."/>
                                </group>
                                <group>
                                    <group string="Model Parameters">
                                        <field name="temperature"/>
                                        <field name="max_tokens"/>
                                        <field name="top_p"/>
                                    </group>
                                    <group string="Capabilities">
                                        <field name="enable_tool_calling"/>
                                        <field name="enable_knowledge_retrieval"/>
                                        <field name="enable_reasoning"/>
                                        <field name="allow_auto_execution"/>
                                    </group>
                                </group>
                            </page>

                            <!-- 简化的 Tools 显示 -->
                            <page string="Tools">
                                <field name="tools_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="code"/>
                                        <field name="is_active"/>
                                    </list>
                                </field>
                            </page>

                            <!-- 简化的 Knowledge 显示 -->
                            <page string="Knowledge">
                                <field name="knowledge_base_ids" nolabel="1" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="active"/>
                                    </list>
                                </field>
                            </page>

                            <page string="Workflows">
                                <group>
                                    <label for="workflow_count" string="Associated Workflows"/>
                                    <div>
                                        <field name="workflow_count" readonly="1"/>
                                        <button name="action_view_workflows"
                                                type="object"
                                                string="Manage Workflows"
                                                class="btn-primary"/>
                                    </div>
                                </group>
                                <div class="alert alert-info" role="alert">
                                    <i class="fa fa-info-circle"/>
                                    Workflows are managed separately. Click the button above to view and manage all workflows associated with this agent.
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Simple Workflow Tree View for use in other contexts -->
        <record id="view_ai_workflow_tree_simple" model="ir.ui.view">
            <field name="name">oudu.bot.workflow.tree.simple</field>
            <field name="model">oudu.bot.workflow</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="is_active"/>
                    <field name="execution_count"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ai_agent" model="ir.actions.act_window">
            <field name="name">AI Agents</field>
            <field name="res_model">oudu.bot.agent</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_ai_agent_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first AI Agent!
                </p>
            </field>
        </record>
    </data>
</odoo>