<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Tree View -->
        <record id="view_ai_workflow_list" model="ir.ui.view">
            <field name="name">oudu.bot.workflow.list</field>
            <field name="model">oudu.bot.workflow</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="agent_id"/>
                    <field name="is_active"/>
                    <field name="execution_count"/>
                    <field name="success_count"/>
                    <field name="failure_count"/>
                </list>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_ai_workflow_form" model="ir.ui.view">
            <field name="name">oudu.bot.workflow.form</field>
            <field name="model">oudu.bot.workflow</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="execute_workflow" type="object" string="Test Workflow" class="btn-primary"/>
                        <field name="is_active" widget="boolean_toggle"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="sequence"/>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="agent_id"/>
                            </group>
                            <group>
                                <field name="is_active"/>
                                <field name="execution_count" readonly="1"/>
                                <field name="success_count" readonly="1"/>
                                <field name="failure_count" readonly="1"/>
                                <field name="last_execution" readonly="1"/>
                            </group>
                        </group>

                        <group string="Description">
                            <field name="description" nolabel="1"/>
                        </group>

                        <notebook>
                            <page string="Workflow Definition">
                                <group>
                                    <field name="workflow_steps" widget="json" nolabel="1"/>
                                </group>
                            </page>

                            <page string="Input/Output">
                                <group>
                                    <field name="input_schema" widget="json" nolabel="1"/>
                                    <field name="output_schema" widget="json" nolabel="1"/>
                                </group>
                            </page>

                            <page string="Execution Settings">
                                <group>
                                    <field name="max_execution_time"/>
                                    <field name="retry_count"/>
                                    <field name="concurrent_executions"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="action_ai_workflow" model="ir.actions.act_window">
            <field name="name">AI Workflows</field>
            <field name="res_model">oudu.bot.workflow</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="view_ai_workflow_list"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create your first AI Workflow!
                </p>
            </field>
        </record>
    </data>
</odoo>