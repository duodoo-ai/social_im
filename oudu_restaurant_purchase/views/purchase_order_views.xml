<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 采购订单报表视图 -->
    <record id="view_restaurant_purchase_report_list" model="ir.ui.view">
        <field name="name">restaurant.purchase.order.report.list</field>
        <field name="model">restaurant.purchase.order</field>
        <field name="arch" type="xml">
            <list string="采购报表">
                <field name="name"/>
                <field name="shop_id"/>
                <field name="chef_id"/>
                <field name="order_date"/>
                <field name="delivery_date"/>
                <field name="state"/>
                <field name="total_amount"/>
                <field name="purchaser_id"/>
                <field name="receiver_id"/>
            </list>
        </field>
    </record>

    <record id="view_restaurant_purchase_report_search" model="ir.ui.view">
        <field name="name">restaurant.purchase.order.report.search</field>
        <field name="model">restaurant.purchase.order</field>
        <field name="arch" type="xml">
            <search>
<!--                <filter string="今日" name="today" domain="[('delivery_date', '=', context_today())]"/>-->
<!--                <filter string="本周" name="this_week" domain="[('delivery_date', '>=', context_today().replace(day=1))]"/>-->
<!--                <filter string="本月" name="this_month" domain="[('delivery_date', '>=', context_today().replace(day=1))]"/>-->
<!--                <filter string="已完成" name="done" domain="[('state', '=', 'done')]"/>-->
                <group expand="0" string="分组按">
                    <filter string="门店" name="group_shop" context="{'group_by': 'shop_id'}"/>
                    <filter string="日期" name="group_date" context="{'group_by': 'delivery_date'}"/>
                    <filter string="状态" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- 采购报表动作 -->
    <record id="action_restaurant_purchase_report" model="ir.actions.act_window">
        <field name="name">采购报表</field>
        <field name="res_model">restaurant.purchase.order</field>
        <field name="view_mode">list,pivot,graph,form</field>
        <field name="view_id" ref="view_restaurant_purchase_report_list"/>
        <field name="search_view_id" ref="view_restaurant_purchase_report_search"/>
        <field name="context">{'search_default_this_month': 1}</field>
        <field name="groups_id" eval="[(4, ref('oudu_restaurant_purchase.group_restaurant_admin'))]"/>
    </record>
</odoo>